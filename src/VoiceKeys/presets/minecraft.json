{
  "name": "Minecraft",
  "switchPhrases": [ "minecraft mode", "minecraft" ],
  "include": [ "gestures" ],     // voice control for the hand-gesture app, see gestures.json
  "announce": "Minecraft mode",
  "game": { "title": "Minecraft", "tile": "minecraft.png", "order": 1 },
  // What the hand controls do here (left-hand finger keys + right-hand clicks), for the controls screen.
  "handLabels": { "w": "Forward", "a": "Left", "d": "Right", "space": "Jump", "s": "Back",
                  "lmb": "Attack / mine", "rmb": "Use / place", "scroll": "Hotbar slot" },
  "speakByDefault": false,       // no voice confirmations mid-game

  // Minecraft Java Edition default controls:
  //   WASD move · Space jump · Left Ctrl sprint · Left Shift sneak · LMB attack/mine · RMB use/place
  //   Q drop · E inventory · F swap hands · 1-9 hotbar · T chat · / command · F5 perspective · Tab players
  // Pairs with hand gestures: your hand aims the camera (hand-mouse, Relative mode), voice does the rest.
  // If you've rebound anything in-game, change the key names below to match.
  //
  // Step programs ("do") and modifiers work exactly like rocket-league.json; see the notes there.
  //   "forward" = 600 ms of W, "a little forward" ≈ 210 ms, "really long forward" ≈ 2.3 s.

  "modifiers": [
    { "say": [ "hard", "big", "long", "far", "lot", "a lot", "more" ],                             "scale": 2.2 },
    { "say": [ "little", "a little", "bit", "a bit", "slight", "slightly", "small", "short",
               "quick", "tiny", "step", "less" ],                                                  "scale": 0.35 },
    { "say": [ "really", "very", "super", "extra" ],                                               "intensify": 1.7 }
  ],
  "minMs": 30,
  "maxMs": 8000,

  "commands": [

    // ---- Moving (latched: keeps going until "stop") ----
    { "category": "Movement", "label": "Walk", "essential": true, "say": [ "walk", "go", "keep walking" ],         "do": [ "unlatch s", "unlatch ctrl", "latch w" ] },
    { "category": "Movement", "say": [ "run", "sprint" ],                      "do": [ "unlatch s", "latch ctrl+w" ] },
    { "category": "Movement", "say": [ "walk back", "back up" ],               "do": [ "unlatch w", "unlatch ctrl", "latch s" ] },
    { "category": "Movement", "essential": true, "say": [ "stop", "halt" ],                       "do": [ "release" ] },
    { "category": "Movement", "say": [ "sneak", "crouch" ],                    "do": [ "latch shift" ] },
    { "category": "Movement", "say": [ "stand up", "stop sneaking" ],          "do": [ "unlatch shift" ] },

    // ---- Moving (timed; scale with modifiers) ----
    { "category": "Movement", "say": [ "forward" ],                            "baseMs": 600, "do": [ "hold w {ms}" ] },
    { "category": "Movement", "say": [ "back", "backward", "backwards" ],      "baseMs": 600, "do": [ "hold s {ms}" ] },
    { "category": "Movement", "say": [ "left", "strafe left" ],                "baseMs": 400, "do": [ "hold a {ms}" ] },
    { "category": "Movement", "say": [ "right", "strafe right" ],              "baseMs": 400, "do": [ "hold d {ms}" ] },
    { "category": "Movement", "say": [ "jump" ],                               "keys": [ "space" ], "holdMs": 60 },
    { "category": "Movement", "say": [ "jump forward", "hop forward" ],        "do": [ "down w", "tap space 60", "wait 500", "up w" ] },
    { "category": "Movement", "say": [ "swim up", "climb" ],                   "baseMs": 1500, "do": [ "hold space {ms}" ] },

    // ---- Hands ----
    { "category": "Actions", "label": "Mine", "essential": true, "say": [ "mine", "break", "dig" ],               "baseMs": 1500, "do": [ "hold lmb {ms}" ] },
    { "category": "Actions", "say": [ "keep mining", "keep digging" ],        "do": [ "latch lmb" ] },
    { "category": "Actions", "say": [ "stop mining", "stop digging" ],        "do": [ "unlatch lmb" ] },
    { "category": "Actions", "say": [ "attack", "hit", "punch" ],             "keys": [ "lmb" ], "holdMs": 50 },
    { "category": "Actions", "label": "Place / use", "essential": true, "say": [ "place", "use", "open" ],               "keys": [ "rmb" ], "holdMs": 50 },
    { "category": "Actions", "say": [ "eat", "drink" ],                       "do": [ "hold rmb 1800" ] },            // eating takes 1.6 s
    { "category": "Actions", "say": [ "shoot", "draw", "pull" ],              "baseMs": 1100, "do": [ "hold rmb {ms}" ] }, // bow: full charge ~1 s
    { "category": "Actions", "say": [ "block", "shield" ],                    "baseMs": 1500, "do": [ "hold rmb {ms}" ] },
    { "category": "Actions", "say": [ "pick block" ],                         "keys": [ "mmb" ] },

    // ---- Items ----
    { "category": "Items", "label": "Inventory", "essential": true, "say": [ "inventory", "close inventory" ],       "keys": [ "e" ] },
    { "category": "Items", "label": "Drop item", "essential": true, "say": [ "drop", "drop item" ],                  "keys": [ "q" ] },
    { "category": "Items", "say": [ "drop stack", "drop all" ],             "keys": [ "ctrl+q" ] },
    { "category": "Items", "say": [ "swap hands", "offhand" ],              "keys": [ "f" ] },

    // ---- Hotbar (the recognizer may write numbers as digits or words, so both are listed) ----
    { "category": "Hotbar", "say": [ "slot one", "slot 1" ],                 "keys": [ "1" ] },
    { "category": "Hotbar", "say": [ "slot two", "slot 2" ],                 "keys": [ "2" ] },
    { "category": "Hotbar", "say": [ "slot three", "slot 3" ],               "keys": [ "3" ] },
    { "category": "Hotbar", "say": [ "slot four", "slot 4" ],                "keys": [ "4" ] },
    { "category": "Hotbar", "say": [ "slot five", "slot 5" ],                "keys": [ "5" ] },
    { "category": "Hotbar", "say": [ "slot six", "slot 6" ],                 "keys": [ "6" ] },
    { "category": "Hotbar", "say": [ "slot seven", "slot 7" ],               "keys": [ "7" ] },
    { "category": "Hotbar", "say": [ "slot eight", "slot 8" ],               "keys": [ "8" ] },
    { "category": "Hotbar", "say": [ "slot nine", "slot 9" ],                "keys": [ "9" ] },

    // ---- Game ----
    { "category": "Game", "say": [ "chat", "open chat" ],                  "keys": [ "t" ] },
    { "category": "Game", "say": [ "command" ],                            "keys": [ "slash" ] },
    { "category": "Game", "say": [ "send", "enter" ],                      "keys": [ "enter" ] },
    { "category": "Game", "label": "Menu", "essential": true, "say": [ "menu", "pause game", "escape" ],       "keys": [ "esc" ] },
    { "category": "Game", "say": [ "perspective", "third person", "first person" ], "keys": [ "f5" ] },
    { "category": "Game", "say": [ "players", "player list" ],             "do": [ "hold tab 2000" ] },
    { "category": "Game", "say": [ "screenshot" ],                         "keys": [ "f2" ] }
  ]
}
