{
  "name": "Desktop",
  "switchPhrases": [ "desktop mode", "desktop" ],
  "include": [ "gestures" ],     // voice control for the hand-gesture app, see gestures.json
  "game": { "title": "Desktop", "tile": "desktop.png", "order": 0 },   // first in "My games": everyday Windows use
  "handLabels": { "lmb": "Left click", "rmb": "Right click" },

  // Each command: phrases you can say -> what happens.
  //   Simple:  "keys": [ "ctrl+a", "ctrl+c" ]          chords tapped in order (optional "holdMs")
  //   Full:    "do":   [ "latch w", "wait 100", ... ]  a step program (see rocket-league.json)
  //   Extras:  "text": "typed after the keys",  "speak": "custom confirmation" ("" = silent)
  // Key names: ctrl shift alt win enter tab esc space backspace delete up down left right
  //            home end pageup pagedown f1-f24 a-z 0-9 volumeup volumedown mute playpause nexttrack prevtrack
  //            lmb rmb mmb mouse4 mouse5
  "commands": [

    { "say": [ "enter", "submit" ],          "keys": [ "enter" ], "category": "Typing", "essential": true },
    { "say": [ "escape", "cancel" ],         "keys": [ "esc" ], "category": "Typing", "essential": true },
    { "say": [ "backspace" ],                "keys": [ "backspace" ], "category": "Typing" },
    { "say": [ "delete word" ],              "keys": [ "ctrl+backspace" ], "category": "Typing" },
    { "say": [ "new line" ],                 "keys": [ "shift+enter" ], "category": "Typing" },

    { "say": [ "up" ],                       "keys": [ "up" ], "category": "Navigation" },
    { "say": [ "down" ],                     "keys": [ "down" ], "category": "Navigation" },
    { "say": [ "left" ],                     "keys": [ "left" ], "category": "Navigation" },
    { "say": [ "right" ],                    "keys": [ "right" ], "category": "Navigation" },
    { "say": [ "page up" ],                  "keys": [ "pageup" ], "category": "Navigation" },
    { "say": [ "page down" ],                "keys": [ "pagedown" ], "category": "Navigation" },
    { "say": [ "go to top", "top" ],         "keys": [ "ctrl+home" ], "category": "Navigation" },
    { "say": [ "go to bottom", "bottom" ],   "keys": [ "ctrl+end" ], "category": "Navigation" },

    { "say": [ "new tab" ],                  "keys": [ "ctrl+t" ], "category": "Browser" },
    { "say": [ "close tab" ],                "keys": [ "ctrl+w" ], "category": "Browser" },
    { "say": [ "reopen tab" ],               "keys": [ "ctrl+shift+t" ], "category": "Browser" },
    { "say": [ "next tab" ],                 "keys": [ "ctrl+tab" ], "category": "Browser" },
    { "say": [ "previous tab", "last tab" ], "keys": [ "ctrl+shift+tab" ], "category": "Browser" },
    { "say": [ "refresh", "reload" ],        "keys": [ "f5" ], "category": "Browser" },
    { "say": [ "go back" ],                  "keys": [ "alt+left" ], "category": "Browser" },
    { "say": [ "go forward" ],               "keys": [ "alt+right" ], "category": "Browser" },

    { "say": [ "switch window" ],            "keys": [ "alt+tab" ], "category": "Windows", "essential": true },
    { "say": [ "show desktop" ],             "keys": [ "win+d" ], "category": "Windows", "essential": true },
    { "say": [ "screenshot" ],               "keys": [ "win+shift+s" ], "category": "Windows", "essential": true },

    { "say": [ "volume up", "louder" ],      "keys": [ "volumeup", "volumeup", "volumeup" ], "category": "Media" },
    { "say": [ "volume down", "quieter" ],   "keys": [ "volumedown", "volumedown", "volumedown" ], "category": "Media" },
    { "say": [ "mute" ],                     "keys": [ "mute" ], "category": "Media" },
    { "say": [ "play", "pause" ],            "keys": [ "playpause" ], "category": "Media", "essential": true },
    { "say": [ "next song", "skip" ],        "keys": [ "nexttrack" ], "category": "Media" },

    // Text-only command (keys can be empty): a canned snippet.
    { "say": [ "sign off" ],                 "keys": [ ], "text": "Thanks,\nKrish", "category": "Snippets" }
  ]
}
