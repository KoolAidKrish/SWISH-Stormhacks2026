<Window x:Class="Swish.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SWISH: debug dashboard" Width="1180" Height="720" MinWidth="820" MinHeight="480"
        Background="#15171B" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2A313B" />
            <Setter Property="BorderBrush" Value="#4A5462" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Status" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C9CED6" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7D8693" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Hand gestures ===== -->
        <DockPanel Margin="0,0,0,10">
            <Button x:Name="HandMouseButton" Content="Hand mouse" Click="OnToggleHandMouse" />
            <Button x:Name="MouseModeButton" Content="Mode" Click="OnCycleMouseMode" />
            <Button Content="Recalibrate…" Click="OnRecalibrate" ToolTip="Hold your hand still on 9 targets" />
            <Button Content="Follow the dot…" Click="OnRecalibratePursuit" ToolTip="Calibrate by following a moving dot for ~30 s" />
            <Button Content="Custom gestures…" Click="OnCustomFunctions" ToolTip="Record your own gestures and voice commands, and choose what they do" />
            <TextBlock x:Name="GestureBanner" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="Black" CornerRadius="6">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                    <TextBlock x:Name="PreviewPlaceholder" Text="Starting camera…" Foreground="#7D8693"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                </Grid>
            </Border>
            <TextBlock x:Name="GestureStatusText" Grid.Row="1" Margin="2,10,2,0" Style="{StaticResource Status}" />
        </Grid>

        <!-- ===== Voice ===== -->
        <DockPanel Grid.Column="2" Margin="0,0,0,10" LastChildFill="False">
            <Button x:Name="VoiceButton" Content="Voice" Click="OnToggleVoice" />
            <ComboBox x:Name="PresetCombo" MinWidth="150" VerticalAlignment="Center" DisplayMemberPath="Name"
                      SelectionChanged="OnPresetChanged" />
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="2" Padding="12,10" Background="#1D2026" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Voice" Style="{StaticResource Heading}" />
                    <TextBlock x:Name="VoiceStatusText" Style="{StaticResource Status}" />
                </StackPanel>

                <!-- Lights up while the push-to-talk key is held -->
                <Border x:Name="TalkBorder" Grid.Row="1" Margin="0,10" Padding="10,8" CornerRadius="6"
                        Background="#22262E" BorderBrush="#2A313B" BorderThickness="1">
                    <TextBlock x:Name="LiveText" Foreground="White" FontSize="16" TextWrapping="Wrap" MinHeight="22" />
                </Border>

                <ListBox x:Name="LogList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0,3" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" Foreground="#5C6573" FontFamily="Consolas" FontSize="12" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Action}" Foreground="#7D8693" FontFamily="Consolas" FontSize="11.5"
                                               TextWrapping="Wrap" Visibility="{Binding ActionVisibility}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="2,10,2,0" Style="{StaticResource Help}"
                   Text="Ctrl+Alt+M hand mouse · Ctrl+Alt+J mouse mode · Ctrl+Alt+V show/hide this window · Ctrl+Alt+Q quit. Pinch = click, fist = lift the mouse. Closing this window keeps SWISH running in the tray." />
    </Grid>
</Window>
