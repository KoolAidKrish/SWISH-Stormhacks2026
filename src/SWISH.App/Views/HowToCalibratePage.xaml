<UserControl x:Class="Swish.App.Views.HowToCalibratePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Swish.App.Controls"
             Background="{StaticResource Bg}">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <ContentControl Style="{StaticResource SectionBar}" HorizontalAlignment="Left" FontSize="30" Margin="0,0,0,22">
            <TextBlock Text="HOW TO CALIBRATE:" Margin="4,0,30,0" />
        </ContentControl>

        <!-- A looping clip of a real calibration, so people see what to do before their own camera starts -->
        <Grid Grid.Row="1" ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Center">
            <MediaElement x:Name="Demo" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True" Stretch="Uniform"
                          MediaEnded="OnDemoEnded" />
            <Border Background="{StaticResource Pink}" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14">
                <TextBlock Text="DEMO" Style="{StaticResource Mono}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Bg}" />
            </Border>
            <Border BorderBrush="{StaticResource Gray}" BorderThickness="1.2" />
        </Grid>

        <DockPanel Grid.Row="1" Grid.Column="2">
            <Button x:Name="StartButton" DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" FontSize="16" Padding="10,10"
                    Click="OnStart" AutomationProperties.Name="Start calibration (or say start)">
                <TextBlock x:Name="StartText" Text="CLICK OR SAY &quot;START&quot;" />
            </Button>
            <TextBlock x:Name="VoiceNote" DockPanel.Dock="Bottom" Style="{StaticResource Mono}" FontSize="11.5"
                       Foreground="{StaticResource Muted}" Margin="0,0,0,10" Visibility="Collapsed" />
            <Border BorderBrush="{StaticResource Gray}" BorderThickness="1" Padding="18,16" Margin="0,0,0,18" VerticalAlignment="Center">
                <ItemsControl x:Name="Steps" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Style="{StaticResource Mono}" Width="26" />
                                <TextBlock Text="{Binding Text}" Style="{StaticResource Mono}" LineHeight="20" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
