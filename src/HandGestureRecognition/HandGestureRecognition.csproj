<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HandGestureRecognition</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- DirectML build: the CPU provider plus any DirectX 12 GPU (Settings › GPU) -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
  </ItemGroup>

  <!-- The DirectML package only copies DirectML.dll for an explicit x64 build; ship it for AnyCPU (64-bit) too.
       ONNX Runtime needs this version, not the older one in System32. -->
  <ItemGroup Condition="'$(Microsoft_AI_DirectML_Bin_Dir_Windows_x64)' != ''">
    <None Include="$(Microsoft_AI_DirectML_Bin_Dir_Windows_x64)\DirectML.dll" Link="DirectML.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Ship the models next to the build output, so a host app (SWISH.App) can find them without
       relying on the working directory. The console app still reads model/ from its working dir. -->
  <ItemGroup>
    <None Update="Model\**\*.onnx;Model\**\*_label.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Native OpenCV binaries. On Linux/macOS, add the OpenCvSharp4 runtime package for your platform instead. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
  </ItemGroup>

</Project>
