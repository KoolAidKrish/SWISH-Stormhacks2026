<Window x:Class="Swish.App.GestureRecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SWISH: record a gesture" Width="1280" Height="820" MinWidth="1000" MinHeight="680"
        Background="#15171B" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2A313B" />
            <Setter Property="BorderBrush" Value="#4A5462" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Steps ===== -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" x:Name="HeaderText" Foreground="White" FontSize="18" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock DockPanel.Dock="Top" x:Name="HandText" Foreground="#7D8693" FontSize="13" Margin="0,0,0,14" />
            <TextBlock DockPanel.Dock="Bottom" Foreground="#7D8693" FontSize="11.5" TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="Each step only counts while your hand is tracked, so there's no need to rush. If the hand leaves the picture, the step pauses until it's back." />
            <ItemsControl x:Name="StepList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Background}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                            <DockPanel>
                                <TextBlock Text="{Binding Marker}" Foreground="{Binding MarkerBrush}" FontSize="15" FontWeight="Bold"
                                           Width="26" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" Foreground="{Binding TitleBrush}" FontSize="14" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- ===== Camera + instruction ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Green/red border = is the right hand being tracked -->
            <Border x:Name="CameraBorder" BorderThickness="8" CornerRadius="10" BorderBrush="#F07178" Background="Black">
                <Grid>
                    <Viewbox Stretch="Uniform">
                        <Grid x:Name="CameraLayer" Width="640" Height="480">
                            <Image x:Name="PreviewImage" Stretch="Fill" />
                            <!-- Target dots for "move it around" (camera pixel coordinates) -->
                            <Canvas x:Name="TargetLayer" Visibility="Collapsed">
                                <Ellipse x:Name="TargetRing" Width="96" Height="96" Stroke="White" StrokeThickness="4" />
                                <Ellipse x:Name="TargetDot" Width="26" Height="26" Fill="#F07178" Stroke="White" StrokeThickness="3" />
                                <Path x:Name="TargetProgress" Stroke="#5BDB5B" StrokeThickness="8" />
                            </Canvas>
                        </Grid>
                    </Viewbox>

                    <!-- Status badge -->
                    <Border x:Name="StatusBadge" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14"
                            CornerRadius="5" Padding="12,6" Background="#F07178">
                        <TextBlock x:Name="StatusText" Foreground="Black" FontWeight="Bold" FontSize="14" />
                    </Border>

                    <!-- Motion cue: a hand that acts out what to do -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" Width="150" Height="150"
                            CornerRadius="75" Background="#C0101114">
                        <TextBlock x:Name="CueHand" Text="✋" FontFamily="Segoe UI Symbol" FontSize="76" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CueScale" />
                                    <RotateTransform x:Name="CueRotate" />
                                    <TranslateTransform x:Name="CueMove" />
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>

                    <!-- Countdown -->
                    <TextBlock x:Name="CountdownText" Foreground="White" FontSize="120" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.9" /></TextBlock.Effect>
                    </TextBlock>

                    <!-- Review: try it live -->
                    <Border x:Name="TryPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,18,0,0" CornerRadius="8" Padding="22,12" Background="#E6101114">
                        <StackPanel>
                            <TextBlock x:Name="TryText" Foreground="White" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" />
                            <ProgressBar x:Name="TryMeter" Height="8" Width="320" Margin="0,8,0,0" Maximum="1"
                                         Foreground="#5BDB5B" Background="#33373F" BorderThickness="0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Instruction -->
            <StackPanel Grid.Row="1" Margin="4,14,4,0">
                <TextBlock x:Name="InstructionText" Foreground="White" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailText" Foreground="#C9CED6" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,0" />
                <DockPanel Margin="0,12,0,0">
                    <TextBlock x:Name="SampleText" DockPanel.Dock="Right" Foreground="#7D8693" FontFamily="Consolas" FontSize="13"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                    <ProgressBar x:Name="StepProgress" Height="10" Maximum="1" Foreground="#5BDB5B" Background="#2A2E36" BorderThickness="0" />
                </DockPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="RedoButton" Content="Start over" Click="OnRedo" />
                <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" />
                <Button x:Name="KeepButton" Content="Keep this gesture" Click="OnKeep" FontWeight="SemiBold" Visibility="Collapsed"
                        Background="#2E5E35" BorderBrush="#5BDB5B" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
