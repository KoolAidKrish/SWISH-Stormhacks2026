<Window x:Class="Swish.App.CustomFunctionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SWISH: custom gestures &amp; commands" Width="1120" Height="780" MinWidth="900" MinHeight="640"
        Background="#15171B" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2A313B" />
            <Setter Property="BorderBrush" Value="#4A5462" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#22262E" />
            <Setter Property="BorderBrush" Value="#4A5462" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C9CED6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7D8693" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#1D2026" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Function list ===== -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Your functions" Style="{StaticResource Heading}" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="+ New" Click="OnNew" />
                <Button x:Name="DeleteButton" Content="Delete" Click="OnDelete" />
            </StackPanel>
            <ListBox x:Name="FunctionList" Background="#1D2026" BorderThickness="0" SelectionChanged="OnSelect"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Summary}" Foreground="#7D8693" FontSize="11.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ===== Editor ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="Editor">
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Name" Style="{StaticResource Label}" />
                    <TextBox x:Name="NameBox" FontSize="14" />
                </DockPanel>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Gesture" Style="{StaticResource Heading}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Hand" Style="{StaticResource Label}" />
                            <ComboBox x:Name="HandCombo" Width="110" Margin="0,0,16,0" SelectedIndex="2">
                                <ComboBoxItem Tag="Right">Right</ComboBoxItem>
                                <ComboBoxItem Tag="Left">Left</ComboBoxItem>
                                <ComboBoxItem Tag="Either">Either</ComboBoxItem>
                            </ComboBox>
                            <TextBlock Text="When made" Style="{StaticResource Label}" />
                            <ComboBox x:Name="ModeCombo" Width="230" Margin="0,0,16,0" SelectedIndex="0">
                                <ComboBoxItem Tag="Once">Run the action once</ComboBoxItem>
                                <ComboBoxItem Tag="Hold">Hold the keys while held</ComboBoxItem>
                            </ComboBox>
                            <Button x:Name="RecordButton" Content="● Record gesture…" Click="OnRecord" />
                            <Button x:Name="RemoveGestureButton" Content="Remove" Click="OnRemoveGesture" />
                        </StackPanel>
                        <TextBlock x:Name="GestureStatus" Foreground="#C9CED6" FontFamily="Consolas" FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Voice" Style="{StaticResource Heading}" />
                        <TextBox x:Name="PhrasesBox" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Phrases that run this function, separated by commas (e.g. &quot;copy that, grab it&quot;). Works in every preset. Leave empty for gesture-only." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Action" Style="{StaticResource Heading}" />
                        <TextBox x:Name="ActionBox" AcceptsReturn="True" Height="92" FontFamily="Consolas" FontSize="13"
                                 VerticalScrollBarVisibility="Auto" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="One per line. A key or chord taps it: ctrl+c · alt+tab · f5 · lmb. Steps: hold w 500 · wait 100 · latch shift · release · type Hello there. For &quot;hold while held&quot;, list plain keys (e.g. w, then shift)." />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save" Click="OnSave" FontWeight="SemiBold" />
                    <Button Content="Test action (in 3 s)" Click="OnTest" />
                    <TextBlock x:Name="MessageText" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" MaxWidth="460" />
                </StackPanel>
            </StackPanel>

            <!-- ===== Camera: recording guide + live recognition ===== -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <Border Background="Black" CornerRadius="6">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Live" Style="{StaticResource Heading}" />
                    <TextBlock x:Name="LiveText" Foreground="#C9CED6" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Help}" Margin="0,12,0,0"
                               Text="Make any saved gesture to see if it's recognised. While a gesture is active, that hand's mouse and finger-keyboard pause, so it won't also click or type." />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
