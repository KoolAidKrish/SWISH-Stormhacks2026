<UserControl x:Class="Swish.App.Views.BindGesturePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Swish.App.Controls"
             Background="{StaticResource Bg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <c:MenuSidebar x:Name="Sidebar" />

        <DockPanel Grid.Column="1" Margin="34,26,30,0">
            <!-- Header, one line: back, title -->
            <DockPanel DockPanel.Dock="Top" Height="64" Margin="0,0,0,18">
                <Button x:Name="BackButton" DockPanel.Dock="Left" Width="40" Height="40" Padding="0" Margin="0,0,16,0" VerticalAlignment="Center"
                        Click="OnBack" ToolTip="Back to controls (Esc)" AutomationProperties.Name="Back to controls">
                    <TextBlock Text="←" FontSize="18" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="REBIND GESTURE" Style="{StaticResource Heading}" FontSize="30" />
                    <TextBlock x:Name="GameText" Style="{StaticResource Mono}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Pink}" />
                </StackPanel>
            </DockPanel>

            <ContentControl DockPanel.Dock="Top" Style="{StaticResource SectionBar}" Margin="0,0,0,22" HorizontalAlignment="Stretch">
                <TextBlock x:Name="SectionText" />
            </ContentControl>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <!-- The gesture -->
                <Grid Width="260" Height="300" Margin="0,0,40,0">
                    <c:ChamferShape Fill="{StaticResource Panel}" Stroke="{StaticResource Pink}" StrokeThickness="1.5" Chamfer="30" Radius="9" />
                    <DockPanel Margin="20,18">
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock x:Name="GestureText" Style="{StaticResource Mono}" FontSize="13" FontWeight="Bold" />
                            <TextBlock x:Name="HandText" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Image x:Name="Art" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="ArtPlaceholder" Text="✋" FontFamily="Segoe UI Symbol" FontSize="64" Foreground="{StaticResource Gray}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- What it presses -->
                <StackPanel Width="420" VerticalAlignment="Center">
                    <TextBlock Text="RIGHT NOW IT DOES" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Gray}" Margin="0,0,0,6" />
                    <TextBlock x:Name="CurrentText" Style="{StaticResource Display}" FontSize="30" Margin="0,0,0,26" />

                    <TextBlock Text="PRESS THIS INSTEAD" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Gray}" Margin="0,0,0,8" />
                    <c:KeyCaptureBox x:Name="KeyBox" HorizontalAlignment="Stretch" Height="44" AutomationProperties.Name="Key to press instead" />
                    <TextBlock x:Name="HelpText" Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,10,0,24" />

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Click="OnSave" Margin="0,0,12,0" AutomationProperties.Name="Save">
                            <TextBlock Text="✓  SAVE" />
                        </Button>
                        <Button x:Name="ResetButton" Click="OnReset" AutomationProperties.Name="Reset to default">
                            <TextBlock Text="RESET TO DEFAULT" />
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="MessageText" Style="{StaticResource Mono}" Margin="0,14,0,0" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
