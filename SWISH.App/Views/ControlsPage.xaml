<UserControl x:Class="Swish.App.Views.ControlsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Swish.App.Controls"
             Background="{StaticResource Bg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <c:MenuSidebar x:Name="Sidebar" />

        <!-- ===== Controls ===== -->
        <DockPanel Grid.Column="1" Margin="34,26,30,0">
            <!-- Header, one line: title, the selected game's banner (fading in), the DEFAULT / CUSTOMIZE toggle -->
            <!-- right margin = the content's 10 + the scroll bar's 8, so the toggle ends where the blue bars do -->
            <DockPanel DockPanel.Dock="Top" Height="64" Margin="0,0,18,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="▶  TUTORIAL" Margin="0,0,14,0" Click="OnTutorial" Padding="8,4" FontSize="12" FontWeight="Bold"
                            AutomationProperties.Name="Show the hand controls tutorial" />
                    <RadioButton x:Name="DefaultToggle" Style="{StaticResource SegmentToggle}" IsChecked="True" Content="DEFAULT"
                                 AutomationProperties.Name="Default controls" />
                    <RadioButton x:Name="CustomizeToggle" Style="{StaticResource SegmentToggle}" Content="CUSTOMIZE +"
                                 Checked="OnCustomize" AutomationProperties.Name="Customize: make your own gestures and voice commands" />
                </StackPanel>
                <Image x:Name="Hero" DockPanel.Dock="Right" Height="56" Stretch="Uniform" Margin="0,0,18,0" IsHitTestVisible="False">
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0" />
                            <GradientStop Color="#B0000000" Offset="0.45" />
                            <GradientStop Color="Black" Offset="1" />
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CONTROLS" Style="{StaticResource Heading}" FontSize="30" />
                    <TextBlock x:Name="GameTitle" Style="{StaticResource Mono}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Pink}" />
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="Notice" DockPanel.Dock="Top" Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Muted}"
                       Margin="0,0,0,12" Visibility="Collapsed" />
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="Sections" Margin="0,0,10,30" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
