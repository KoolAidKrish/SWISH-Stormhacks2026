<UserControl x:Class="Swish.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Swish.App.Controls"
             Background="{StaticResource Bg}">
  <Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <c:MenuSidebar x:Name="Sidebar" />
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="34,26,34,40" MaxWidth="640" HorizontalAlignment="Left" Width="560">
            <!-- Header, one line: back, title (same as the command editor) -->
            <DockPanel Height="64" Margin="0,0,0,18">
                <Button x:Name="BackButton" DockPanel.Dock="Left" Width="40" Height="40" Padding="0" Margin="0,0,16,0" VerticalAlignment="Center"
                        Click="OnBack" ToolTip="Back to controls (Esc)" AutomationProperties.Name="Back to controls">
                    <TextBlock Text="←" FontSize="18" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SETTINGS" Style="{StaticResource Heading}" FontSize="30" />
                    <TextBlock Text="CAMERA, MICROPHONE AND MORE" Style="{StaticResource Mono}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Pink}" />
                </StackPanel>
            </DockPanel>

            <!-- Camera -->
            <ContentControl Style="{StaticResource SectionBar}" Margin="0,0,0,16">
                <TextBlock Text="📷  CAMERA" />
            </ContentControl>
            <ComboBox x:Name="CameraBox" Margin="0,0,0,14" SelectionChanged="OnCamera" AutomationProperties.Name="Camera" />
            <Button Click="OnRecalibrate" Margin="0,0,0,30" AutomationProperties.Name="Re-calibrate webcam">
                <TextBlock Text="RE-CALIBRATE WEBCAM" />
            </Button>

            <!-- Microphone -->
            <ContentControl Style="{StaticResource SectionBar}" Margin="0,0,0,16">
                <TextBlock Text="🎙  MICROPHONE" />
            </ContentControl>
            <ComboBox x:Name="MicBox" Margin="0,0,0,14" SelectionChanged="OnMic" AutomationProperties.Name="Microphone" />
            <Border BorderBrush="{StaticResource Gray}" BorderThickness="1.2" Padding="14,10" Margin="0,0,0,30">
                <DockPanel>
                    <Button x:Name="TestMicButton" DockPanel.Dock="Left" Click="OnTestMic" Margin="0,0,14,0" VerticalAlignment="Center"
                            AutomationProperties.Name="Test microphone">
                        <TextBlock x:Name="TestMicText" Text="TEST MIC" />
                    </Button>
                    <!-- Segmented level meter -->
                    <ItemsControl x:Name="Meter" Focusable="False" VerticalAlignment="Center" Height="30"
                                  AutomationProperties.Name="Microphone level">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- GPU -->
            <ContentControl Style="{StaticResource SectionBar}" Margin="0,0,0,16">
                <TextBlock Text="🖥  GPU" />
            </ContentControl>
            <ComboBox x:Name="GpuBox" Margin="0,0,0,8" SelectionChanged="OnGpu" AutomationProperties.Name="Run hand tracking on" />
            <TextBlock x:Name="GpuNote" Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,0,0,30" />

            <!-- Voice assistant: the spoken confirmations (ElevenLabs text-to-speech) -->
            <ContentControl Style="{StaticResource SectionBar}" Margin="0,0,0,16">
                <TextBlock Text="🗣  VOICE ASSISTANT" />
            </ContentControl>
            <StackPanel x:Name="SpeechPanel" Margin="0,0,0,30">
                <DockPanel Margin="0,0,0,14">
                    <TextBlock Text="SPOKEN REPLIES" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Gray}" Width="130" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Margin="-8,0,0,0">
                        <RadioButton x:Name="SpeechOn" GroupName="Speech" Style="{StaticResource SegmentToggle}" Content="ON" Checked="OnSpeechMute" />
                        <RadioButton x:Name="SpeechMuted" GroupName="Speech" Style="{StaticResource SegmentToggle}" Content="MUTED" Checked="OnSpeechMute" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,0,0,14">
                    <TextBlock Text="VOICE" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Gray}" Width="130" VerticalAlignment="Center" />
                    <ComboBox x:Name="SpeechVoiceBox" SelectionChanged="OnSpeechVoice" AutomationProperties.Name="Assistant voice" />
                </DockPanel>
                <DockPanel Margin="0,0,0,14">
                    <TextBlock Text="VOLUME" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Gray}" Width="130" VerticalAlignment="Center" />
                    <TextBlock x:Name="SpeechVolumeText" DockPanel.Dock="Right" Style="{StaticResource Mono}" Width="48" TextAlignment="Right" VerticalAlignment="Center" />
                    <Slider x:Name="SpeechVolume" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" ValueChanged="OnSpeechVolume"
                            AutomationProperties.Name="Assistant volume" VerticalAlignment="Center" />
                </DockPanel>
                <Button Click="OnTestSpeech" AutomationProperties.Name="Test the assistant voice">
                    <TextBlock Text="▶  TEST VOICE" />
                </Button>
                <TextBlock x:Name="SpeechNote" Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,10,0,0"
                           Text="SWISH says a short reply when a voice command runs. A new voice is generated by ElevenLabs once, then cached." />
            </StackPanel>

            <!-- Advanced: hidden from the typical user -->
            <Expander Style="{StaticResource CategoryExpander}" Header="ADVANCED">
                <StackPanel Margin="2,4,0,0">
                    <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,0,0,10"
                               Text="Live status, the annotated camera view, the voice log and the classic calibrations, for troubleshooting." />
                    <Button Click="OnDebug" AutomationProperties.Name="Open debug dashboard">
                        <TextBlock Text="OPEN DEBUG DASHBOARD" />
                    </Button>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
