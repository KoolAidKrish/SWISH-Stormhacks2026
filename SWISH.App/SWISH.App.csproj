<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the tray NotifyIcon -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SWISH</AssemblyName>
    <RootNamespace>Swish.App</RootNamespace>
    <!-- WinForms analyzer: wants DPI set via its API, but this is a WPF app (WinForms is only the tray icon). -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms both define Application, Point, etc. Keep WPF's as the default. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled fonts (SIL Open Font License, see Fonts/OFL-*.txt) and placeholder-able artwork -->
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Assets\**\*.png" />
    <!-- MediaElement plays from a file, not a resource -->
    <Content Include="Assets\Video\*.mp4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both console apps double as libraries: their engines run in-process here. -->
    <ProjectReference Include="..\HandGestureRecognition\HandGestureRecognition.csproj" />
    <ProjectReference Include="..\VoiceKeys\VoiceKeys.csproj" />
  </ItemGroup>

</Project>
