<!--
    SWISH design tokens. Colors are the same values as the landing site (landing/src/index.css),
    sampled from the mockups: charcoal backgrounds, deep teal brand, hot pink accent.
    Fonts are bundled (SWISH.App/Fonts, SIL Open Font License): Barlow Condensed for display,
    JetBrains Mono for labels, buttons and body.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== Colors ===== -->
    <Color x:Key="BgColor">#262626</Color>          <!-- page background -->
    <Color x:Key="Bg2Color">#1E1E1E</Color>         <!-- deeper wells (sidebar, camera letterbox) -->
    <Color x:Key="PanelColor">#2E2E2E</Color>       <!-- cards -->
    <Color x:Key="LineColor">#3D3D3D</Color>        <!-- dividers, inactive outlines -->
    <Color x:Key="TealColor">#00566E</Color>        <!-- brand: section bars, primary button -->
    <Color x:Key="Teal2Color">#007493</Color>       <!-- brand hover -->
    <Color x:Key="TealTextColor">#6CC6DE</Color>    <!-- teal readable as text on dark (~8:1) -->
    <Color x:Key="PinkColor">#F59AF7</Color>        <!-- accent: highlights, traced path, focus ring -->
    <Color x:Key="WhiteColor">#F5F5F2</Color>       <!-- text, outlines -->
    <Color x:Key="GrayColor">#D9D9D9</Color>
    <Color x:Key="MutedColor">#A9A9A9</Color>       <!-- secondary text, inactive -->
    <Color x:Key="DimColor">#6B6B6B</Color>         <!-- faint guide lines -->
    <Color x:Key="CyanColor">#2EC4F0</Color>        <!-- hand skeleton dots -->
    <Color x:Key="DangerColor">#FF6B6B</Color>
    <Color x:Key="SuccessColor">#7BE09A</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="Teal" Color="{StaticResource TealColor}" />
    <SolidColorBrush x:Key="Teal2" Color="{StaticResource Teal2Color}" />
    <SolidColorBrush x:Key="TealText" Color="{StaticResource TealTextColor}" />
    <SolidColorBrush x:Key="Pink" Color="{StaticResource PinkColor}" />
    <SolidColorBrush x:Key="White" Color="{StaticResource WhiteColor}" />
    <SolidColorBrush x:Key="Gray" Color="{StaticResource GrayColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Dim" Color="{StaticResource DimColor}" />
    <SolidColorBrush x:Key="Cyan" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="HoverWash" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="PressWash" Color="#40FFFFFF" />

    <!-- ===== Fonts ===== -->
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Fonts/#Barlow Condensed</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Fonts/#JetBrains Mono</FontFamily>

    <!-- ===== Sizes ===== -->
    <sys:Double x:Key="Chamfer">14</sys:Double>
    <Thickness x:Key="PagePadding">40,32,40,32</Thickness>
</ResourceDictionary>
