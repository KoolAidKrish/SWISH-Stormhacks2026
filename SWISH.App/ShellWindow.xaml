<Window x:Class="Swish.App.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Swish.App.Controls"
        Title="SWISH" Width="1200" Height="760" MinWidth="960" MinHeight="620"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource White}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Our own title bar: the window keeps its native resize, snap and Win+arrow behaviour. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource Gray}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Tag" Value="{StaticResource HoverWash}" />   <!-- hover fill -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter Property="Foreground" Value="{StaticResource White}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource PressWash}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Tag"><Setter.Value><SolidColorBrush Color="#E5484D" /></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <DockPanel x:Name="Root">
        <!-- ===== Title bar ===== -->
        <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="38" Background="{StaticResource Bg2}">
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource Line}" />
            <!-- blue tab under the wordmark -->
            <c:ChamferShape Width="150" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Left" Fill="{StaticResource Blue}" Chamfer="3" Corner="TopRight" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="/Assets/Brand/wordmark.png" Height="15" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="SWISH" />
                <TextBlock Text="HANDS + VOICE CONTROL" Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Dim}"
                           VerticalAlignment="Center" Margin="14,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border x:Name="PausedChip" BorderBrush="{StaticResource Pink}" BorderThickness="1.2" Padding="10,3" Margin="0,0,14,0"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="❚❚  PAUSED" Style="{StaticResource Mono}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Pink}" />
                </Border>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close to tray (SWISH keeps running)" />
            </StackPanel>
        </Grid>

        <Grid>
            <ContentControl x:Name="Host" Focusable="False" IsTabStop="False" />

            <!-- Camera corner: a small live view (with the hand skeleton) over the bottom-right of menu screens -->
            <Grid x:Name="CameraCorner" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22"
                  Width="272" Height="204" Visibility="Collapsed" Background="{StaticResource Bg2}">
                <ContentControl x:Name="CameraHost" Focusable="False" IsTabStop="False" />
                <Border BorderBrush="{StaticResource Pink}" BorderThickness="1.6" IsHitTestVisible="False" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Width="26" Height="26" Padding="0"
                        Background="#B0101010" BorderBrush="{StaticResource Gray}" BorderThickness="1" Click="OnHideCamera"
                        ToolTip="Hide the camera" AutomationProperties.Name="Hide camera view">
                    <TextBlock Text="✕" FontSize="11" />
                </Button>
            </Grid>
            <!-- When it's hidden: a small tab to bring it back -->
            <Button x:Name="CameraTab" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22" Padding="12,6"
                    Background="{StaticResource Bg2}" BorderBrush="{StaticResource Pink}" Click="OnShowCamera" Visibility="Collapsed"
                    ToolTip="Show the camera view" AutomationProperties.Name="Show camera view">
                <TextBlock Text="▴  CAMERA" FontSize="11" FontWeight="Bold" />
            </Button>

            <!-- Overlay: a panel pulled up over the current screen (e.g. the tutorial); click outside or Esc to close -->
            <Grid x:Name="Overlay" Visibility="Collapsed">
                <Rectangle Fill="#CC000000" MouseLeftButtonDown="OnOverlayBackdrop" />
                <Grid Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <c:ChamferShape Fill="{StaticResource Bg}" Stroke="{StaticResource Pink}" StrokeThickness="1.5" Chamfer="24" Radius="7" Corner="BottomRight" />
                    <ContentControl x:Name="OverlayHost" Focusable="False" IsTabStop="False" />
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
